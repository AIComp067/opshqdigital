---
// QuoteBlock — customer testimonial styling distinct from prose <blockquote>.
interface Props {
  quote: string;
  name: string;
  role?: string;
  company?: string;
}
const { quote, name, role, company } = Astro.props;
---
<figure class="bg-gradient-to-br from-navy-950 to-navy-800 text-white rounded-2xl p-8 sm:p-10 my-8 relative overflow-hidden">
  <div class="absolute top-4 left-6 text-blue-500/30 text-7xl font-serif leading-none" aria-hidden="true">“</div>
  <blockquote class="relative">
    <p class="text-lg sm:text-xl leading-relaxed text-slate-100 italic">{quote}</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3 not-italic">
    <div class="w-1 h-12 bg-blue-500 rounded-full" aria-hidden="true"></div>
    <div>
      <p class="font-semibold text-white">{name}</p>
      {(role || company) && (
        <p class="text-sm text-slate-300">
          {role}{role && company && ' · '}{company}
        </p>
      )}
    </div>
  </figcaption>
</figure>
