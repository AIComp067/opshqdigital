---
// PricingCard — fixed-price OR no-price display for productized offerings.
// Mobile: flex-col default. Desktop: flex-row.
// Spec'd by Sonnet (design agent). Placed 60-70% down a service page.
interface Props {
  productName: string;
  monthlyFee?: string;         // e.g. "$649" — omit to hide the price block entirely
  setupFee?: string;           // e.g. "$0" or "$949" — pass "$0" or omit for none
  pilotOffer?: string;         // e.g. "30-day free pilot"
  features: string[];
  ctaText?: string;
  ctaHref?: string;
  footnote?: string;
}
const {
  productName,
  monthlyFee,
  setupFee,
  pilotOffer,
  features,
  ctaText = 'Get Started',
  ctaHref = '/contact/',
  footnote,
} = Astro.props;
---
<div class="bg-white border-2 border-blue-500 rounded-2xl p-6 sm:p-8 shadow-xl shadow-blue-500/10 max-w-3xl mx-auto">
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 mb-6">
    <div>
      <p class="text-xs font-semibold text-blue-500 uppercase tracking-wider mb-2">{productName}</p>
      {monthlyFee && (
        <div class="flex items-baseline gap-2">
          <span class="text-4xl sm:text-5xl font-bold text-navy-950">{monthlyFee}</span>
          <span class="text-slate-500 text-base">/ month</span>
        </div>
      )}
      {!monthlyFee && pilotOffer && (
        <p class="text-2xl sm:text-3xl font-bold text-navy-950">{pilotOffer}</p>
      )}
      {!monthlyFee && !pilotOffer && (
        <p class="text-2xl sm:text-3xl font-bold text-navy-950">Quoted on the discovery call</p>
      )}
      {monthlyFee && pilotOffer && <p class="text-sm text-blue-500 font-medium mt-2">✓ {pilotOffer}</p>}
      {monthlyFee && setupFee && setupFee !== '$0' && (
        <p class="text-sm text-slate-500 mt-2">+ {setupFee} one-time setup</p>
      )}
      {monthlyFee && (!setupFee || setupFee === '$0') && (
        <p class="text-sm text-slate-500 mt-2">No setup fee</p>
      )}
      {!monthlyFee && (
        <p class="text-sm text-slate-500 mt-2">Monthly fee scoped on the discovery call. Cancel anytime after the pilot.</p>
      )}
    </div>
    <a
      href={ctaHref}
      class="inline-flex items-center justify-center px-6 py-3 bg-blue-500 text-white font-medium rounded-lg hover:bg-blue-600 transition-colors min-h-[44px] whitespace-nowrap"
    >
      {ctaText} →
    </a>
  </div>

  <div class="border-t border-slate-200 pt-6">
    <p class="text-sm font-semibold text-navy-950 mb-3">What's included:</p>
    <ul class="space-y-2">
      {features.map(f => (
        <li class="flex items-start gap-2 text-sm text-slate-700">
          <span class="text-blue-500 flex-shrink-0 mt-0.5" aria-hidden="true">✓</span>
          <span>{f}</span>
        </li>
      ))}
    </ul>
  </div>

  {footnote && <p class="text-xs text-slate-500 mt-6 italic">{footnote}</p>}
</div>
