---
// MetricCard — before/after stat pair for case studies + service pages.
// Mobile-first: stacks vertically on small, side-by-side on md+.
interface Props {
  label: string;
  before: string;
  after: string;
  caption?: string;
}
const { label, before, after, caption } = Astro.props;
---
<div class="bg-white border border-slate-200 rounded-xl p-5 sm:p-6">
  <p class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3">{label}</p>
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
    <div class="flex-1 text-center sm:text-left">
      <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Before</p>
      <p class="text-2xl sm:text-3xl font-bold text-slate-400 line-through decoration-2">{before}</p>
    </div>
    <div class="text-blue-500 text-2xl sm:text-3xl hidden sm:block" aria-hidden="true">→</div>
    <div class="text-blue-500 text-2xl sm:hidden text-center" aria-hidden="true">↓</div>
    <div class="flex-1 text-center sm:text-right">
      <p class="text-xs text-blue-500 uppercase tracking-wider mb-1 font-semibold">After</p>
      <p class="text-2xl sm:text-3xl font-bold text-navy-950">{after}</p>
    </div>
  </div>
  {caption && <p class="text-xs text-slate-500 mt-3 italic">{caption}</p>}
</div>
