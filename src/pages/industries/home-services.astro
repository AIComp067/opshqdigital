---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MoneyMath from '../../components/MoneyMath.astro';
import IndustryBadge from '../../components/IndustryBadge.astro';
import MetricCard from '../../components/MetricCard.astro';

const faqs = [
  {
    q: "How does this help me book more jobs?",
    a: "Homeowners contacting a contractor almost always message several at once, and the first business to respond usually wins the estimate. AI Inbox replies to every website form, Angi/Thumbtack lead, and Google message within 5 minutes — in your voice, with the questions you need answered — so you stop losing jobs to whoever called back first.",
  },
  {
    q: "I'm on a roof or under a sink all day — how do I approve replies?",
    a: "A quick tap on your phone: approve, edit, or skip. The default is human-in-the-loop, so nothing goes out without you. Trusted repeat customers can be set to auto-send. It takes seconds between jobs instead of an hour at the kitchen table at 9pm.",
  },
  {
    q: "Will it quote a price or commit me to a date?",
    a: "No. It never quotes a binding price, never holds or commits a date, and never sends anything you haven't approved. It confirms the request, gathers the job details (scope, address, timing, photos), and books the estimate — you keep every pricing and scheduling decision.",
  },
  {
    q: "Can you also build me a website that shows up on Google?",
    a: "Yes. We build fast, mobile-first sites (Astro on Azure) built to rank for \"[your trade] near me\" and turn visitors into booked estimates, wired straight into your inbox and calendar. Real Core Web Vitals, real local SEO — not a slow template.",
  },
  {
    q: "What does it cost?",
    a: "It starts with a free 30-minute consultation. If we're a fit, a short requirements session and a one-time setup fee get you live, then a simple monthly fee covers hosting and ongoing optimization — scoped to what you need. No long-term contract, and you see every number before you commit.",
  },
];
---
<BaseLayout
  title="AI Lead Response + Websites for Home Services & Contractors | OpsHQ Digital"
  description="Contractors, HVAC, plumbing, electrical, roofing & landscaping: the first to reply wins the estimate. We give you 5-minute AI responses to every lead, a website that ranks, and follow-up automation. Start with a free 30-minute consultation."
>
  <section class="bg-navy-950 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="flex items-center gap-2 mb-6"><IndustryBadge label="For Home & Trade Services" variant="charter" /></div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-6">Win the Estimate While You're Still on the Job.</h1>
        <p class="text-base md:text-lg text-slate-300 mb-8 leading-relaxed">
          HVAC, plumbing, electrical, roofing, remodels, landscaping — homeowners message three contractors at once and hire whoever answers first. We answer for you in under 5 minutes, in your voice, so you book more work without living in your inbox.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact/?service=home-services" class="inline-flex items-center justify-center px-8 py-4 bg-blue-500 text-white font-medium rounded-lg hover:bg-blue-600 transition-colors text-lg min-h-[44px]">Free Discovery Call →</a>
          <a href="/tools/email-response-grader/" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-medium rounded-lg transition-colors text-lg min-h-[44px]">Grade My Current Response Time</a>
        </div>
      </div>
      <div class="relative">
        <img src="/images/hero-home.jpg" alt="Home services contractor winning estimates with instant AI lead replies" width="1440" height="960" class="rounded-2xl shadow-2xl shadow-blue-500/10 w-full" />
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-500/20 to-teal-500/20 rounded-2xl blur-xl -z-10"></div>
      </div>
      </div>
    </div>
  </section>

  <MoneyMath unit="job" href="/contact/?service=home-services" />

  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 mb-4"><div class="w-2 h-2 bg-blue-500 rounded-full"></div><span class="text-sm font-semibold text-blue-500 uppercase tracking-wider">The Problem</span></div>
      <h2 class="text-2xl md:text-3xl font-bold text-navy-950 mb-6">Your Best Leads Come In While Your Hands Are Full.</h2>
      <div class="text-slate-600 leading-relaxed space-y-4 text-lg">
        <p>A homeowner submits a form at 10am. You see it at 6pm after the last job. By then they've already scheduled an estimate with the contractor who texted back in fifteen minutes.</p>
        <p class="font-semibold text-navy-950">Replying within 5 minutes makes a lead up to <strong>9× more likely</strong> to convert. Most contractors reply in hours — or the lead slips through entirely.</p>
        <p>You don't need to answer your phone on a ladder. You need a system that responds instantly, captures the job details, and books the estimate on your calendar.</p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-2 mb-4"><div class="w-2 h-2 bg-blue-500 rounded-full"></div><span class="text-sm font-semibold text-blue-500 uppercase tracking-wider">What We Build for Trades</span></div>
      <h2 class="text-2xl md:text-3xl font-bold text-navy-950 mb-12 text-center">More Booked Estimates, Less Inbox Time</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 border border-slate-200"><div class="text-3xl mb-3">⚡</div><h3 class="text-lg font-bold text-navy-950 mb-2">5-Minute Lead Responses</h3><p class="text-sm text-slate-600 leading-relaxed">Website forms, Angi, Thumbtack, Google messages — all answered within minutes in your voice, gathering scope, address, timing and photos, with a link to book the estimate. Approve from your phone between jobs.</p></div>
        <div class="bg-white rounded-xl p-6 border border-slate-200"><div class="text-3xl mb-3">🌐</div><h3 class="text-lg font-bold text-navy-950 mb-2">A Site That Ranks Locally</h3><p class="text-sm text-slate-600 leading-relaxed">Fast, mobile-first website built to show up for "[trade] near me," with the reviews, service areas, and photos that win trust — wired straight into your inbox and calendar.</p></div>
        <div class="bg-white rounded-xl p-6 border border-slate-200"><div class="text-3xl mb-3">🔁</div><h3 class="text-lg font-bold text-navy-950 mb-2">Follow-Up That Closes</h3><p class="text-sm text-slate-600 leading-relaxed">Automatic, polite follow-ups on estimates you've sent, so quotes don't die in a homeowner's inbox. Optional review requests after the job to build your Google rating.</p></div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-2 mb-4"><div class="w-2 h-2 bg-blue-500 rounded-full"></div><span class="text-sm font-semibold text-blue-500 uppercase tracking-wider">Proof It Works</span></div>
      <h2 class="text-2xl md:text-3xl font-bold text-navy-950 mb-12 text-center">Live on a Real High-Volume Service Business</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <MetricCard label="Reply Time" before="4 hours" after="8 min" caption="Average first response across every inquiry" />
        <MetricCard label="Leads Captured" before="48%" after="68%" caption="Inquiries that book a call or estimate" />
      </div>
      <div class="text-center mt-10"><a href="/work/inquiry-response-automation/" class="text-blue-500 font-medium hover:underline text-lg">Read the full case study →</a></div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 mb-4"><div class="w-2 h-2 bg-blue-500 rounded-full"></div><span class="text-sm font-semibold text-blue-500 uppercase tracking-wider">Questions Contractors Ask</span></div>
      <h2 class="text-2xl md:text-3xl font-bold text-navy-950 mb-8">FAQ</h2>
      <div class="space-y-4">
        {faqs.map(f => (
          <details class="group bg-white rounded-xl border border-slate-200 p-6">
            <summary class="flex items-center justify-between cursor-pointer font-semibold text-navy-950 list-none">{f.q}<span class="text-blue-500 group-open:rotate-45 transition-transform text-2xl leading-none">+</span></summary>
            <p class="mt-4 text-slate-600 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-navy-950 text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Stop Losing Jobs to a Slow Reply</h2>
      <p class="text-lg text-slate-300 mb-8">Free 30-minute call. We'll map how leads reach you today and show you where the booked work is leaking out.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a href="/contact/?service=home-services" class="inline-flex items-center justify-center px-8 py-4 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition-colors text-lg min-h-[44px]">Book a Discovery Call</a>
        <a href="/tools/email-response-grader/" class="inline-flex items-center justify-center px-8 py-4 bg-white text-navy-950 font-medium rounded-lg hover:bg-slate-100 transition-colors text-lg min-h-[44px]">Try the Free Grader →</a>
      </div>
    </div>
  </section>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "Service",
      "name": "AI Lead Response + Websites for Home Services & Contractors",
      "serviceType": "Lead response automation, web development, and CRM for home service contractors",
      "provider": { "@id": "https://opshqdigital.com/#organization" },
      "areaServed": ["Seattle", "Washington", "United States"],
      "audience": { "@type": "BusinessAudience", "audienceType": "Home service and trade contractors (HVAC, plumbing, electrical, roofing, remodeling, landscaping)" },
      "url": "https://opshqdigital.com/industries/home-services/"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    })} />
  </Fragment>
</BaseLayout>
