---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingCard from '../components/PricingCard.astro';

const addons = [
  { icon: '⚡', label: 'AI Inbox — 5-minute lead response' },
  { icon: '📊', label: 'ROI / ROAS / ROAI reporting' },
  { icon: '📈', label: 'Live results dashboard' },
  { icon: '🧠', label: 'Premium AI models' },
  { icon: '🤖', label: 'Extra AI automations' },
  { icon: '🌐', label: 'Websites & landing pages' },
  { icon: '🔎', label: 'SEO & AI-search citations' },
  { icon: '📍', label: 'Google Business Profile & local' },
  { icon: '🔁', label: 'Follow-up cadence' },
  { icon: '➕', label: 'Usage top-ups' },
  { icon: '⭐', label: 'Priority optimization' },
];
---
<BaseLayout
  title="Pricing — OpsHQ Digital"
  description="Transparent pricing for AI Inbox and custom work. No hidden fees, no annual contracts."
>
  <!-- Hero -->
  <section class="bg-navy-950 text-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Simple, Honest Pricing</h1>
      <p class="text-lg text-slate-300">No public price list — every business is different. It starts with a free 30-minute consultation. If we're a fit, a one-time setup fee gets you live, then a simple monthly fee covers hosting and ongoing optimization.</p>
    </div>
  </section>

  <!-- Productized -->
  <section class="py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-2 mb-4">
        <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
        <span class="text-sm font-semibold text-blue-500 uppercase tracking-wider">Productized Service</span>
      </div>
      <h2 class="text-3xl font-bold text-navy-950 mb-8 text-center">AI Inbox</h2>
      <PricingCard
        productName="AI Inbox"
        headline="Free consultation to start"
        features={[
          "Custom AI assistant trained on your business's voice + pricing + packages",
          "Inquiry monitoring across Microsoft 365 or Google Workspace",
          "5-minute first-response SLA",
          "Human-in-the-loop approval via mobile push",
          "Calendar integration for booking calls or tours",
          "Direct support from Nick — no ticket queue",
          "Audit log of every draft, edit, approval, and send",
          "No long-term contract — 30-day notice to cancel, clean data export",
        ]}
        ctaText="Book Your Consultation"
        ctaHref="/contact/?service=ai-inbox"
        footnote="Built for high-touch service businesses: wedding venues, photographers, planners, caterers, transportation operators, contractors, agencies."
      />
    </div>
  </section>

  <!-- Custom work -->
  <section class="py-16 md:py-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-2 h-2 bg-blue-500 rounded-full"></div>
        <span class="text-sm font-semibold text-blue-500 uppercase tracking-wider">Custom Work</span>
      </div>
      <h2 class="text-3xl font-bold text-navy-950 mb-6">Everything Else: Setup, Then a Simple Monthly Fee</h2>
      <div class="text-slate-700 space-y-4 text-lg leading-relaxed">
        <p>Custom CRM, AI agents, integrations, cloud setup, websites — the price depends on what you actually need, and we'd rather quote it once we understand the scope than pretend a number on a marketing page applies to your situation.</p>
        <p>Here's how it works:</p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3"><span class="text-blue-500 mt-1.5">•</span> <span><strong>Free 30-minute consultation.</strong> Tell us the problem. We'll tell you whether we can help and roughly what it'll cost — on the call, not a week later.</span></li>
          <li class="flex items-start gap-3"><span class="text-blue-500 mt-1.5">•</span> <span><strong>Requirements session + one-time setup fee.</strong> A short working session to pin down exactly what you need, then a one-time fee to build and connect everything.</span></li>
          <li class="flex items-start gap-3"><span class="text-blue-500 mt-1.5">•</span> <span><strong>Simple monthly fee.</strong> Flat hosting plus optimization — scoped to what you actually need each month. It ticks up when we're actively improving things and settles back down when we're not.</span></li>
          <li class="flex items-start gap-3"><span class="text-blue-500 mt-1.5">•</span> <span><strong>No long-term contract.</strong> Month-to-month, 30-day notice to cancel, and your data always exports cleanly.</span></li>
        </ul>
        <p class="pt-4">See <a href="/capabilities/" class="text-blue-500 font-medium hover:underline">the capabilities page</a> for what we typically build.</p>
      </div>
      <div class="mt-10">
        <a href="/contact/?service=custom" class="inline-flex items-center px-8 py-4 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition-colors text-lg min-h-[44px]">
          Book a Discovery Call →
        </a>
      </div>
    </div>
  </section>

  <!-- Bundles & add-ons (availability only) -->
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 mb-4"><div class="w-2 h-2 bg-blue-500 rounded-full"></div><span class="text-sm font-semibold text-blue-500 uppercase tracking-wider">Grows With You</span></div>
      <h2 class="text-2xl md:text-3xl font-bold text-navy-950 mb-4">Bundles &amp; Add-Ons, Available as You Grow</h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8 max-w-2xl">Start lean, then layer on only what moves the needle. Everything below is available and scoped on your consultation — you only pay for what's turned on, and we adjust it month to month as your needs change.</p>
      <div class="flex flex-wrap gap-2.5">
        {addons.map(a => (
          <span class="inline-flex items-center gap-2 bg-white border border-slate-200 rounded-full px-4 py-2 text-sm font-medium text-navy-950"><span aria-hidden="true">{a.icon}</span> {a.label}</span>
        ))}
      </div>
      <p class="text-sm text-slate-500 mt-8">The headline metric we build toward: <strong class="text-navy-950">ROAI — Return on AI</strong> — proving the system pays for itself. We recommend a starting bundle on your consultation.</p>
    </div>
  </section>
</BaseLayout>
