---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, description, ogImage = '/og-home.png', noindex = false, canonical } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, 'https://opshqdigital.com').href;
const siteName = 'OpsHQ Digital';
const buildDateIso = new Date().toISOString();
const buildDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());

// Path-derived BreadcrumbList JSON-LD (skipped on homepage; only when 2+ segments).
// Slug-to-display converts hyphens to spaces, title-cases each word.
// Ported from SPL pattern for May 2026 EEAT consistency.
const path = Astro.url.pathname;
const pathSegments = path.split('/').filter(Boolean);
const slugToDisplay = (slug) =>
  slug.split('-').map(w => w.length === 2 ? w.toUpperCase() : (w.charAt(0).toUpperCase() + w.slice(1))).join(' ');
const breadcrumbItems = pathSegments.length > 0 ? [
  { name: 'Home', url: 'https://opshqdigital.com/' },
  ...pathSegments.map((seg, i) => {
    const accumPath = '/' + pathSegments.slice(0, i + 1).join('/') + '/';
    const isLast = i === pathSegments.length - 1;
    const name = slugToDisplay(seg);
    return isLast ? { name } : { name, url: `https://opshqdigital.com${accumPath}` };
  })
] : [];
const breadcrumbSchema = breadcrumbItems.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbItems.map((item, i) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'name': item.name,
    ...(item.url ? { 'item': item.url } : {})
  }))
} : null;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://opshqdigital.com/#organization",
  "name": siteName,
  "url": "https://opshqdigital.com/",
  "description": "Boutique Seattle-area technology services agency building CRM automation, AI agents, custom integrations, and fast web builds for small businesses.",
  "email": "nick@opshqdigital.com",
  "founder": {
    "@type": "Person",
    "name": "Nick Reef"
  },
  "areaServed": ["Seattle", "Washington", "United States"],
  "knowsAbout": ["CRM automation", "AI agents", "Web development", "Custom integrations", "Microsoft Graph API", "Azure", "Cloudflare"],
  "dateModified": buildDateIso
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://opshqdigital.com/#website",
  "url": "https://opshqdigital.com/",
  "name": siteName,
  "publisher": { "@id": "https://opshqdigital.com/#organization" },
  "inLanguage": "en-US"
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "dateModified": buildDateIso,
  "inLanguage": "en-US",
  "isPartOf": { "@id": "https://opshqdigital.com/#website" },
  "about": { "@id": "https://opshqdigital.com/#organization" }
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />

  <!-- Google Search Console verification -->
  <meta name="google-site-verification" content="y5R9XzhgQVadE_OOq-AZ78ix2cKsuH3GB1iwXXL8N1k" />
  <meta name="msvalidate.01" content="6C172B20D4DA826EC8D9E261D6280750" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  {noindex && <meta name="robots" content="noindex" />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`https://opshqdigital.com${ogImage}`} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="OpsHQ Digital" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`https://opshqdigital.com${ogImage}`} />

  <!-- Preload fonts -->
  <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />

  {/* Person schema for Nick (founder) — site-wide EEAT signal (May 2026 Core Update).
       Standalone Person entity referenced via @id from Organization.founder. */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://opshqdigital.com/#nick-founder",
    "name": "Nick Reef",
    "jobTitle": "Founder & Developer",
    "url": "https://opshqdigital.com/about/",
    "worksFor": { "@id": "https://opshqdigital.com/#organization" },
    "homeLocation": {
      "@type": "Place",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Maple Valley",
        "addressRegion": "WA",
        "addressCountry": "US"
      }
    },
    "knowsAbout": [
      "CRM automation", "AI agents", "Web development", "Custom integrations",
      "Microsoft Graph API", "Microsoft 365", "Azure", "Cloudflare",
      "Production software engineering"
    ],
    "hasCredential": [
      "10+ years building production software",
      "Microsoft Azure + Graph API specialist",
      "Full-stack engineering — backend, frontend, infrastructure",
      "Maple Valley, WA — Pacific Northwest based"
    ]
  })} />

  {/* Path-derived BreadcrumbList JSON-LD (skipped on homepage). */}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <slot name="head" />

  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <!-- Skip link -->
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-[100] focus:bg-blue-500 focus:text-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium">
    Skip to main content
  </a>

  <Header />

  <main id="main" class="flex-1">
    <slot />
  </main>

  <Footer buildDate={buildDate} />
  <CookieConsent />

  <slot name="schema" />
</body>
</html>
